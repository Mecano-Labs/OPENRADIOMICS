# OpenRadiomics - Local Development Environment
# Copy this file to .env.local and fill in the values

# Database (RDS)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@openradiomics-dev-db.cwznsagquzwy.us-east-1.rds.amazonaws.com:5432/openradiomics

# Or individual components:
DB_HOST=openradiomics-dev-db.cwznsagquzwy.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=openradiomics
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD

# AWS (uses your local AWS credentials by default)
AWS_REGION=us-east-1
S3_BUCKET_NAME=openradiomics-dev-dicom-445305334312

# Cognito
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXX
COGNITO_DOMAIN=openradiomics-dev.auth.us-east-1.amazoncognito.com

# Flask
SECRET_KEY=dev-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=1
